#!/bin/sh
# Workspace menu: switch, new, remove — context header on top.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

set -u

abort() { exit 0; }

log() {
    printf '%s %s\n' "$(date +%H:%M:%S)" "$*" \
        >> "${HERDR_PLUGIN_STATE_DIR:-${TMPDIR:-/tmp}}/menu.log" 2>/dev/null
}

entries=$(mktemp)
branches=$(mktemp)
trap 'rm -f "$entries" "$branches"' EXIT

context_cwd=$(printf '%s' "${HERDR_PLUGIN_CONTEXT_JSON:-}" | jq -r '.cwd // empty' 2>/dev/null)
context_cwd=${context_cwd:-$PWD}
current=$(cd "$context_cwd" 2>/dev/null && jj root 2>/dev/null) || true

print_header() {
    stat_line=$(jj diff --stat 2>/dev/null | tail -n 1)
    add=$(printf '%s\n' "$stat_line" | sed -n 's/^.*,\ \([0-9][0-9]*\)\ insertions.*/+\1/p')
    del=$(printf '%s\n' "$stat_line" | sed -n 's/^.*,\ \([0-9][0-9]*\)\ deletions.*/-\1/p')
    add=${add:-+0}
    del=${del:--0}
    gum style --bold --foreground 6 "$(basename "$dir")"
    gum style --faint "$dir"
    printf '%s %s\n\n' "$(gum style --foreground 2 "$add")" "$(gum style --foreground 1 "$del")"
}

verb="new workspace…"
if [ -n "$current" ]; then
    dir=$current
    cd "$dir" || abort
    print_header
    verb=$(gum choose "switch workspace" "$verb" "remove current") || abort
    case $verb in
        switch)
            exec herdr plugin pane open --plugin aamini.jj --entrypoint picker
            ;;
        remove)
            gum confirm "remove current jj workspace?" || abort
            exec herdr-jj remove --current --yes
            ;;
    esac
else
    # Outside a repo only creation makes sense: pick the project first.
    zoxide query -l 2>/dev/null | while IFS= read -r dir; do
        [ -d "$dir/.jj" ] || continue
        cd "$dir" 2>/dev/null && pwd
    done > "$entries"
    [ -s "$entries" ] || abort
    dir=$(gum filter --placeholder "project…" < "$entries") || abort
    cd "$dir" || abort
    print_header
fi
log "menu at $dir: $verb"

. "$(dirname "$0")/common"

trunk_rev=$(resolve_trunk) || abort
trunk_name=$(trunk_name_for "$trunk_rev")
[ -n "$trunk_name" ] || trunk_name=trunk

cur_bm=$(jj log --no-graph -r @ -T 'bookmarks' 2>/dev/null | awk 'NR==1{print $1}')

printf '%s\n' "$(gum style --bold trunk) ($trunk_name)" > "$branches"
if [ -n "$cur_bm" ] && [ "$cur_bm" != "$trunk_name" ]; then
    printf '%s\n' "$(gum style --bold --foreground 4 "$cur_bm") (current)" >> "$branches"
fi
jj bookmark list 2>/dev/null | sed -n 's/^\([^ :][^:]*\):.*/\1/p' | while IFS= read -r b; do
    [ "$b" = "$trunk_name" ] && continue
    [ "$b" = "$cur_bm" ] && continue
    printf '%s\n' "$b"
done >> "$branches"

sel=$(gum filter --placeholder "base branch…" < "$branches") || abort
clean=$(printf '%s' "$sel" | sed 's/\x1b\[[0-9;]*m//g')
case $clean in
    'trunk '?*)
        rev=$trunk_rev
        # jw names the workspace bookmark after the workspace; a trunk-named
        # workspace would collide with the trunk bookmark itself.
        default_name=
        ;;
    *)
        clean=${clean%\ (current)}
        rev=$clean
        if ! jj log --no-graph -r "$rev" -T "" >/dev/null 2>&1; then
            rev="$clean@origin"
        fi
        default_name=$clean
        ;;
esac
log "base rev $rev"

name=$(gum input --placeholder "workspace name" --value "$default_name") || abort
name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-\{2,\}/-/g; s/^-\|-$//')
[ -n "$name" ] || abort

workspace_root() {
    jj workspace list -T 'self.name() ++ "\t" ++ self.root() ++ "\n"' 2>/dev/null \
        | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }'
}

if gum spin --title "creating $name…" -- jw add "$name" --at "$rev"; then
    log "created $name at $rev in $dir"
elif [ -n "$(workspace_root)" ]; then
    log "create failed for $name; existing workspace found, opening"
    gum confirm "workspace '$name' exists — open it?" || abort
else
    log "jw add failed for $name at $rev in $dir"
    exit 1
fi

root=$(workspace_root)
[ -n "$root" ] || abort
herdr-jj reporter ensure 2>/dev/null || true
exec herdr-jj open "$root" --project-path "$dir"
